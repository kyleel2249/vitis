# ─── Core (required) ──────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, RDS, Render, Railway…)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Long random string used to sign login sessions: openssl rand -hex 32
SESSION_SECRET=
# Public URL of the deployed site (used for metadata + email links)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── Database options (optional) ──────────────────────────────────
# DATABASE_SSL=true            # force TLS on/off (auto-detected from the URL otherwise)
# DATABASE_POOL_MAX=10

# ─── First admin account (recommended for production) ─────────────
# Created/updated by `npm run db:seed`. Demo accounts are NOT created in production
# unless SEED_DEMO_USERS=true.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Administrator
# SEED_DEMO_USERS=false

# ─── Stripe payments (required for checkout) ──────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From Stripe Dashboard → Developers → Webhooks → endpoint https://your-domain.com/api/stripe/webhook
# events: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=

# ─── Email (optional — order + newsletter emails) ─────────────────
RESEND_API_KEY=
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com

# ─── Firebase sign-in (optional — email/password works without it) ─
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Build switches (optional) ────────────────────────────────────
# NEXT_OUTPUT=standalone       # Docker image build
# IMAGES_UNOPTIMIZED=true      # Cloudflare Workers (no sharp)
