# Cloudflare Pages → Settings → Variables and Secrets (names only; never commit real values)

# ─── Core (required) ──────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
SESSION_SECRET=            # openssl rand -hex 32
NEXT_PUBLIC_SITE_URL=https://your-domain.com      # build variable

# ─── Database options (optional) ──────────────────────────────────
# DATABASE_SSL=true         # force TLS on/off (auto-detected from the URL otherwise)

# ─── First admin account (db:seed, run from your machine) ─────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Administrator
# SEED_DEMO_USERS=false     # demo accounts are dev-only unless set to true

# ─── Stripe payments (required for checkout) ──────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=      # endpoint: https://your-domain.com/api/stripe/webhook

# ─── Email (optional) ─────────────────────────────────────────────
RESEND_API_KEY=
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com  # build variable
